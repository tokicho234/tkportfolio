# Neon: Dashboard > your project > Connect > copy the pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Passcode you type into the Admin Portal
ADMIN_PASSCODE=choose-a-long-passphrase

# Random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
